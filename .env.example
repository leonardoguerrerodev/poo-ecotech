# EcoTech — configuración opcional de los servicios externos.
# Copie este archivo como .env (que NO se sube al repositorio) y cambie lo que necesite.
# Si una variable no está, se usa el valor de abajo. Solo se aceptan direcciones https.
#
# Ninguna de las dos APIs pide llave. Si alguna la pidiera, iría aquí como
# ECOTECH_API_KEY=..., nunca escrita en el código.

ECOTECH_URL_GEOCODIFICACION=https://geocoding-api.open-meteo.com/v1/search
ECOTECH_URL_CLIMA=https://api.open-meteo.com/v1/forecast
ECOTECH_URL_INDICADORES=https://mindicador.cl/api
ECOTECH_TIEMPO_ESPERA=10
